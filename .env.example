# --- LLM (optional) ---
# Unset: agent/assess.py's rule-based assessor runs.
# Set: agent/llm_assess.py (Claude) runs instead, same interface.
ANTHROPIC_API_KEY=

# --- TigerGraph Savanna / Community Edition ---
TG_HOST=https://your-instance.i.tgcloud.io
TG_GRAPH_NAME=FraudGraph
# Create in the Savanna UI: Database Secrets -> Create Secret
TG_SECRET=

# Where the real dataset lives (see data/HHGOA_IEEE/DATASET_README.md)
REAL_DATA_DIR=data/HHGOA_IEEE
